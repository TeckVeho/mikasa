NEXT_PUBLIC_API_URL=http://localhost:8080
# 未設定のままだと開発時のみモック有効。実 API を使うときは false を明示。
# ブラウザだけで切り替え: sessionStorage.setItem("logivoice:useMock","0") または "1" して再読込
NEXT_PUBLIC_USE_MOCK=
# true のときは Firebase の ID トークンより X-Dev-Tenant-Id を優先（ローカルでデータが出ないときは true に）
NEXT_PUBLIC_USE_DEV_AUTH=true
NEXT_PUBLIC_DEV_TENANT_ID=01HZXEXAMPLE00000000000000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
