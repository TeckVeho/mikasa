NEXT_PUBLIC_API_URL=http://localhost:8080
# API origin only (no /api/v1 suffix). Client fetch paths include /v1/... (see apps/web/lib/api.ts).
# 省略時は NEXT_PUBLIC_API_URL のオリジンから wss/ws を推測（API と Web が別ホストの本番では NEXT_PUBLIC_API_URL を必ずセット）。
# NEXT_PUBLIC_API_WS_URL=
# 未設定のままだと開発時のみモック有効。実 API を使うときは false を明示。
# ブラウザだけで切り替え: sessionStorage.setItem("logivoice:useMock","0") または "1" して再読込
NEXT_PUBLIC_USE_MOCK=
# true のときは Firebase の ID トークンより X-Dev-Tenant-Id を優先（ローカルでデータが出ないときは true に）
NEXT_PUBLIC_USE_DEV_AUTH=true
NEXT_PUBLIC_DEV_TENANT_ID=01HZXEXAMPLE00000000000000
# Production Docker image: bake via Cloud Build / docker build-arg (see apps/web/Dockerfile, cloudbuild.*.yaml).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
