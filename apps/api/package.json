{
  "name": "@logivoice/api",
  "prisma": {
    "seed": "node prisma/dist/seed.js"
  },
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && tsc -p tsconfig.seed.json",
    "seed:dev": "tsx prisma/seed.ts",
    "dev": "tsx watch --env-file=../../.env --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/storage": "^5.20.4",
    "@google-cloud/text-to-speech": "^5.7.0",
    "@logivoice/shared": "*",
    "@prisma/client": "^6.2.1",
    "alawmulaw": "^6.0.0",
    "bullmq": "^5.34.5",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "jsonpath-plus": "^10.4.0",
    "multer": "^2.1.1",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "prisma": "^6.2.1",
    "resend": "6.1.3",
    "twilio": "^5.4.0",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
