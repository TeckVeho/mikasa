generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @db.VarChar(26)
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users              User[]
  productTypes       ProductType[]
  processTypes       ProcessType[]
  teams              Team[]
  calendars          Calendar[]
  capacitySettings   CapacitySetting[]
  projects           Project[]
  historicalAverages HistoricalAverage[]
  scheduleModel      ScheduleModel?

  @@map("tenants")
}

model User {
  id          String   @id @db.VarChar(26)
  tenantId    String   @map("tenant_id") @db.VarChar(26)
  email       String   @unique @db.VarChar(255)
  firebaseUid String   @unique @map("firebase_uid") @db.VarChar(128)
  role        String   @default("operator") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]

  @@index([firebaseUid])
  @@map("users")
}

model ProductType {
  id            String    @id @db.VarChar(26)
  tenantId      String    @map("tenant_id") @db.VarChar(26)
  name          String    @db.VarChar(100)
  category      String    @db.VarChar(20)
  sortOrder     Int       @default(0) @map("sort_order")
  regressionA   Decimal?  @map("regression_a") @db.Decimal(12, 8)
  regressionB   Decimal?  @map("regression_b") @db.Decimal(10, 3)
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects           Project[]
  historicalAverages HistoricalAverage[]

  @@index([tenantId])
  @@map("product_types")
}

model ProcessType {
  id           String  @id @db.VarChar(26)
  tenantId     String  @map("tenant_id") @db.VarChar(26)
  name         String  @db.VarChar(50)
  displayOrder Int     @map("display_order")
  defaultRatio Decimal @map("default_ratio") @db.Decimal(6, 4)
  isWelding    Boolean @default(false) @map("is_welding")

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processRecords      ProcessRecord[]
  scheduleModelDays   ScheduleModelDay[]

  @@index([tenantId])
  @@map("process_types")
}

model Team {
  id        String    @id @db.VarChar(26)
  tenantId  String    @map("tenant_id") @db.VarChar(26)
  name      String    @db.VarChar(100)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members            TeamMember[]
  projects           Project[]
  projectTeams       ProjectTeam[]
  processRecords     ProcessRecord[]
  capacitySettings   CapacitySetting[]
  historicalAverages HistoricalAverage[]

  @@index([tenantId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @db.VarChar(26)
  teamId    String   @map("team_id") @db.VarChar(26)
  name      String   @db.VarChar(100)
  userId    String?  @map("user_id") @db.VarChar(26)
  createdAt DateTime @default(now()) @map("created_at")

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("team_members")
}

model Calendar {
  id          String   @id @db.VarChar(26)
  tenantId    String   @map("tenant_id") @db.VarChar(26)
  date        DateTime @db.Date
  isHoliday   Boolean  @default(false) @map("is_holiday")
  holidayName String?  @map("holiday_name") @db.VarChar(100)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("calendars")
}

model CapacitySetting {
  id                 String   @id @db.VarChar(26)
  tenantId           String   @map("tenant_id") @db.VarChar(26)
  teamId             String?  @map("team_id") @db.VarChar(26)
  category           String   @db.VarChar(20)
  regularHoursPerDay Decimal  @map("regular_hours_per_day") @db.Decimal(5, 1)
  overtime2hPerDay   Decimal  @map("overtime_2h_per_day") @db.Decimal(5, 1)
  overtime4hPerDay   Decimal  @map("overtime_4h_per_day") @db.Decimal(5, 1)
  headcount          Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tenantId, teamId, category])
  @@map("capacity_settings")
}

model Project {
  id                String    @id @db.VarChar(26)
  tenantId          String    @map("tenant_id") @db.VarChar(26)
  projectNumber     String    @map("project_number") @db.VarChar(20)
  clientName        String?   @map("client_name") @db.VarChar(200)
  projectName       String    @map("project_name") @db.VarChar(200)
  productTypeId     String?   @map("product_type_id") @db.VarChar(26)
  deadline          DateTime? @db.Date
  weight            Decimal?  @db.Decimal(10, 2)
  memberLength      Decimal?  @map("member_length") @db.Decimal(10, 2)
  drawingReceivedAt DateTime? @map("drawing_received_at") @db.Date
  plannedHours      Decimal?  @map("planned_hours") @db.Decimal(8, 1)
  weldingRatio      Decimal?  @map("welding_ratio") @db.Decimal(6, 4)
  teamId            String?   @map("team_id") @db.VarChar(26)
  status            String    @default("pending") @db.VarChar(30)
  category          String?   @db.VarChar(20)
  setCount          Int?      @map("set_count")
  detail            String?   @db.VarChar(500)
  pastAverageHours  Decimal?  @map("past_average_hours") @db.Decimal(8, 1)
  scheduleStartDate DateTime? @map("schedule_start_date") @db.Date
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType    ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  projectTeams   ProjectTeam[]
  processRecords ProcessRecord[]

  @@unique([tenantId, projectNumber])
  @@index([tenantId, teamId])
  @@index([tenantId, status])
  @@map("projects")
}

model ProjectTeam {
  id        String   @id @db.VarChar(26)
  projectId String   @map("project_id") @db.VarChar(26)
  teamId    String   @map("team_id") @db.VarChar(26)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([teamId])
  @@map("project_teams")
}

model ProcessRecord {
  id            String   @id @db.VarChar(26)
  projectId     String   @map("project_id") @db.VarChar(26)
  processTypeId String   @map("process_type_id") @db.VarChar(26)
  teamId        String   @map("team_id") @db.VarChar(26)
  date          DateTime @db.Date
  hours         Decimal  @db.Decimal(6, 2)
  recordType    String   @default("actual") @map("record_type") @db.VarChar(10)
  recordedBy    String?  @map("recorded_by") @db.VarChar(26)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processType ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, processTypeId, teamId, date, recordType], map: "process_records_proj_proc_team_date_type_key")
  @@index([date])
  @@index([recordType])
  @@index([teamId])
  @@map("process_records")
}

model ScheduleModel {
  id        String   @id @db.VarChar(26)
  tenantId  String   @unique @map("tenant_id") @db.VarChar(26)
  totalDays Int      @map("total_days")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayPatterns ScheduleModelDay[]

  @@map("schedule_models")
}

model ScheduleModelDay {
  id              String  @id @db.VarChar(26)
  scheduleModelId String  @map("schedule_model_id") @db.VarChar(26)
  processTypeId   String  @map("process_type_id") @db.VarChar(26)
  dayOffset       Int     @map("day_offset")
  hoursRatio      Decimal @map("hours_ratio") @db.Decimal(8, 6)

  scheduleModel ScheduleModel @relation(fields: [scheduleModelId], references: [id], onDelete: Cascade)
  processType   ProcessType   @relation(fields: [processTypeId], references: [id], onDelete: Cascade)

  @@unique([scheduleModelId, processTypeId, dayOffset], map: "schedule_model_days_model_proc_day_key")
  @@index([scheduleModelId])
  @@map("schedule_model_days")
}

model HistoricalAverage {
  id                   String    @id @db.VarChar(26)
  tenantId             String    @map("tenant_id") @db.VarChar(26)
  productTypeId        String    @map("product_type_id") @db.VarChar(26)
  projectNumber        String    @map("project_number") @db.VarChar(26)
  clientName           String?   @map("client_name") @db.VarChar(200)
  bridgeName           String?   @map("bridge_name") @db.VarChar(200)
  completedAt          DateTime? @map("completed_at") @db.Date
  teamId               String    @map("team_id") @db.VarChar(26)
  manufacturingPlanned Decimal?  @map("manufacturing_planned") @db.Decimal(8, 1)
  salesPlanned         Decimal?  @map("sales_planned") @db.Decimal(8, 1)
  weight               Decimal?  @db.Decimal(10, 2)
  assemblyPrepHours    Decimal?  @map("assembly_prep_hours") @db.Decimal(8, 1)
  assemblyHours        Decimal?  @map("assembly_hours") @db.Decimal(8, 1)
  weldingHours         Decimal?  @map("welding_hours") @db.Decimal(8, 1)
  distortionHours      Decimal?  @map("distortion_hours") @db.Decimal(8, 1)
  paintingHours        Decimal?  @map("painting_hours") @db.Decimal(8, 1)
  finishingHours       Decimal?  @map("finishing_hours") @db.Decimal(8, 1)
  totalHours           Decimal?  @map("total_hours") @db.Decimal(8, 1)
  projectCount         Int?      @map("project_count")
  memberLength         Decimal?  @map("member_length") @db.Decimal(10, 2)
  weightPerMeter       Decimal?  @map("weight_per_meter") @db.Decimal(10, 2)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productTypeId, projectNumber])
  @@index([tenantId, productTypeId, teamId])
  @@map("historical_averages")
}
