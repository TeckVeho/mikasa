DATABASE_URL="postgresql://logivoice:logivoice@localhost:5433/logivoice?schema=public"
REDIS_URL="redis://localhost:6379"
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=https://localhost:8080/webhooks/twilio/voice
AMIVOICE_APP_KEY=
OPENAI_API_KEY=
# シナリオAIウィザードの OpenAI モデル（省略時 gpt-4o-mini）
# OPENAI_WIZARD_MODEL=
GEMINI_API_KEY=
# 省略時は models/gemini-3.1-flash-live-preview
# GEMINI_MODEL=
# シナリオAIウィザードの Gemini モデル（省略時 gemini-2.0-flash-lite）
# GEMINI_MODEL_TEXT=
# シナリオAIウィザードの LLM: auto（Gemini→429時にOpenAIへ）| gemini | openai
# SCENARIO_WIZARD_LLM=auto
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
PUBSUB_TOPIC_CALL_COMPLETED=call-completed
API_PUBLIC_URL=http://localhost:8080
# 公開フォーム /v1/forms の署名用（本番は32文字以上のランダム値を推奨）
FORM_TOKEN_SECRET=
# メール通知（Resend）
RESEND_API_KEY=
RESEND_FROM_EMAIL=LogiVoice <noreply@logivoice.app>
# 管理画面URL（メール内リンク用。省略時 NEXT_PUBLIC_API_URL を使用）
# DASHBOARD_URL=https://app.logivoice.com
# 本番のみ（カンマ区切り）。未設定だとブラウザからの API 呼び出しは不可
# CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=http://localhost:8080
