# =============================================================================
# Bootstrap stack — copy to terraform.tfvars (local file is gitignored).
#
# Run once per GCP project before dev/stg/prod app stacks.
# Creates: Terraform state bucket, Docker Artifact Registry, Cloud Build bucket.
#
# Apply:
#   cd google-cloud/terraform/live/bootstrap
#   terragrunt init && terragrunt apply
# =============================================================================

project_id = "mikasa-load-management"
region     = "asia-northeast1"

state_bucket_name = "mikasa-load-management-terraform-state"

# Empty → default {project_id}-docker (e.g. mikasa-load-management-docker).
# artifact_repo_id = ""

artifact_cleanup_keep_count                 = 10
artifact_cleanup_keep_tag_prefixes          = ["prod", "stg", "dev"]
artifact_cleanup_delete_untagged_after_days = 7

# enable_project_delete_lien = true
# project_delete_lien_origin = "mikasa-terraform-bootstrap"
