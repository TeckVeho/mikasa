# =============================================================================
# Prod app stack — copy to terraform.tfvars (gitignored).
#
# Same GCP project as dev; prod resources use *-prod suffix and separate state prefix.
# Terragrunt: google-cloud/terraform/live/prod/app
#
# Apply order: bootstrap → prod/network → push :prod images → prod/app
#
# Auto-created resources use the same patterns as dev (see dev/app/terraform.tfvars.example).
# =============================================================================

project_id = "your-gcp-project-id"
env_suffix = "prod"
region     = "asia-northeast1"

resource_tier = "tier3"

container_image     = "asia-northeast1-docker.pkg.dev/your-gcp-project-id/your-gcp-project-id-docker/logivoice-api:prod"
web_container_image = "asia-northeast1-docker.pkg.dev/your-gcp-project-id/your-gcp-project-id-docker/logivoice-web:prod"

container_port     = 8080
web_container_port = 3000
enable_web         = true

allow_unauthenticated     = false
allow_unauthenticated_web = false

env_vars = {
  NODE_ENV  = "production"
  LOG_LEVEL = "info"

  CORS_ORIGIN        = "https://app.example.com"
  API_PUBLIC_URL     = "https://api.example.com"
  TWILIO_WEBHOOK_URL = "https://api.example.com/webhooks/twilio/voice"

  FIREBASE_PROJECT_ID = "your-gcp-project-id"
  TWILIO_ACCOUNT_SID  = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

  RESEND_FROM_EMAIL = "LogiVoice <noreply@example.com>"
}

web_env_vars = {
  NODE_ENV = "production"

  NEXT_PUBLIC_API_URL  = "https://api.example.com"
  NEXT_PUBLIC_BASE_URL = "https://app.example.com"

  NEXT_PUBLIC_FIREBASE_API_KEY     = "your-firebase-web-api-key"
  NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN = "your-gcp-project-id.firebaseapp.com"
  NEXT_PUBLIC_FIREBASE_PROJECT_ID  = "your-gcp-project-id"

  NEXT_PUBLIC_USE_MOCK     = "false"
  NEXT_PUBLIC_USE_DEV_AUTH = "false"
}

api_secret_env_from_sm = [
  { env_name = "TWILIO_AUTH_TOKEN", secret_id = "logivoice-twilio-auth-token-prod", version = "latest" },
  { env_name = "OPENAI_API_KEY",    secret_id = "logivoice-openai-prod",            version = "latest" },
  { env_name = "GEMINI_API_KEY",    secret_id = "logivoice-gemini-api-key-prod",    version = "latest" },
  { env_name = "AMIVOICE_APP_KEY",  secret_id = "logivoice-amivoice-prod",          version = "latest" },
  { env_name = "FORM_TOKEN_SECRET", secret_id = "logivoice-form-token-prod",        version = "latest" },
  { env_name = "RESEND_API_KEY",    secret_id = "logivoice-resend-prod",            version = "latest" },
]

api_custom_domain = "api.example.com"
web_custom_domain = "app.example.com"

enable_cloud_sql = true

network_remote_state_bucket = "your-gcp-project-id-terraform-state"
network_remote_state_prefix = "network/prod"

# Prod: keep SQL running 24/7; backups enabled (prod always backs up at 17:00 UTC ≈ 02:00 JST).
enable_sql_night_weekend_schedule = false

sql_backup_enabled                 = true
sql_backup_start_time              = "17:00"
sql_point_in_time_recovery_enabled = false

# env_iam_principals = {
#   deployers = ["group:gcp-prod-deployers@example.com"]
#   readonly  = ["group:gcp-prod-readonly@example.com"]
# }
