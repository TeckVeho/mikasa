# =============================================================================
# Dev network stack — copy to terraform.tfvars (gitignored).
#
# Creates VPC, Direct VPC subnet, and private service peering for Cloud SQL.
# Required before dev/app when enable_cloud_sql = true.
#
# Apply order:
#   1. bootstrap (state bucket)
#   2. live/dev/network  (Terragrunt)
#   3. live/dev/app
# =============================================================================

project_id = "mikasa-lm-dev"
region     = "asia-northeast1"
env_suffix = "dev"

network_name = "mikasa-lm-dev-vpc-dev"

connector_subnet_cidr = "10.8.0.0/24"

private_service_peering_cidr = "10.247.0.0"
