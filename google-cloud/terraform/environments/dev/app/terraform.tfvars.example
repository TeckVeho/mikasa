# =============================================================================
# Dev app stack — copy to terraform.tfvars (gitignored).
#
# Single GCP project; dev is isolated by env_suffix and resource naming (*-dev).
# Terragrunt: google-cloud/terraform/live/dev/app → loads this file.
#
# Apply order:
#   bootstrap → dev/network → build & push images → dev/app
#
# Images must exist in Artifact Registry before apply (Cloud Build or docker push).
#
# --- Auto-created (no tfvars needed) ---
#   Cloud Run : {project_id}-api-dev, {project_id}-web-dev
#   GCS       : {project_id}-uploads-dev
#   Migrate job: {project_id}-migrate-dev
#   Firebase ADC: roles/firebaseauth.admin on runtime SA {project_id}-run-dev
# =============================================================================

project_id = "mikasa-load-management"
env_suffix = "dev"
region     = "asia-northeast1"

resource_tier = "tier3"

cloud_run_api_timeout = "3600s"
cloud_run_api_memory  = "512Mi"

# --- Container images (tag must match Cloud Build _TAG, usually "dev") ---
container_image     = "asia-northeast1-docker.pkg.dev/mikasa-load-management/mikasa-load-management-docker/mikasa-api:dev"
web_container_image = "asia-northeast1-docker.pkg.dev/mikasa-load-management/mikasa-load-management-docker/mikasa-web:dev"

container_port     = 8080
web_container_port = 3000
enable_web         = true
enable_worker      = false

# Dev: allow public web; API stays IAM-protected (grant invoker to web SA or use dev auth headers).
allow_unauthenticated     = false
allow_unauthenticated_web = true

env_vars = {
  NODE_ENV            = "production"
  LOG_LEVEL           = "info"
  CORS_ORIGIN         = "https://mikasa-load-management-web-dev-REPLACE.run.app"
  API_PUBLIC_URL      = "https://mikasa-load-management-api-dev-REPLACE.run.app"
  FIREBASE_PROJECT_ID = "mikasa-load-management"
}

web_env_vars = {
  NODE_ENV = "production"

  NEXT_PUBLIC_API_URL  = "https://mikasa-load-management-api-dev-REPLACE.run.app"
  NEXT_PUBLIC_BASE_URL = "https://mikasa-load-management-web-dev-REPLACE.run.app"

  NEXT_PUBLIC_FIREBASE_API_KEY     = "your-firebase-web-api-key"
  NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN = "mikasa-load-management.firebaseapp.com"
  NEXT_PUBLIC_FIREBASE_PROJECT_ID  = "mikasa-load-management"

  NEXT_PUBLIC_USE_MOCK     = "false"
  NEXT_PUBLIC_USE_DEV_AUTH = "true"
  NEXT_PUBLIC_DEV_TENANT_ID = "01HZXEXAMPLE00000000000000"
}

# Create secrets in GCP Secret Manager before apply (values not in git).
api_secret_env_from_sm = [
  { env_name = "FIREBASE_PRIVATE_KEY", secret_id = "mikasa-firebase-private-key-dev", version = "latest" },
  { env_name = "FIREBASE_CLIENT_EMAIL", secret_id = "mikasa-firebase-client-email-dev", version = "latest" },
]

# --- Custom domains (optional; leave empty to use default *.run.app URLs) ---
api_custom_domain = ""
web_custom_domain = ""

enable_cloud_sql = true

network_remote_state_bucket = "mikasa-load-management-terraform-state"
network_remote_state_prefix = "network/dev"

enable_sql_night_weekend_schedule = true
sql_schedule_timezone             = "Asia/Tokyo"
sql_schedule_start_cron           = "0 8 * * 1-5"
sql_schedule_stop_cron            = "0 22 * * 1-5"
